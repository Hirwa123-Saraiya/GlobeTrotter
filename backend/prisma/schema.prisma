datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Trip {
  id           Int        @id @default(autoincrement())
  user_id      Int        @default(1)
  name         String     @db.VarChar(150)
  description  String?    @db.Text
  cover_image  String?    @db.Text
  start_date   DateTime   @db.Date
  end_date     DateTime   @db.Date
  total_budget Decimal    @default(0.00) @db.Decimal(10, 2)
  vibe         String?    @default("Balanced") @db.VarChar(50)
  status       String?    @default("planning") @db.VarChar(20)
  is_public    Boolean    @default(false)
  share_token  String?    @unique @db.VarChar(64)
  created_at   DateTime   @default(now()) @db.Timestamptz()
  stops        TripStop[]

  @@map("trips")
}

model TripStop {
  id             Int      @id @default(autoincrement())
  trip_id        Int
  city_name      String   @db.VarChar(100)
  arrival_date   DateTime @db.Date
  departure_date DateTime @db.Date
  sequence_order Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz()
  trip           Trip     @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("trip_stops")
}
