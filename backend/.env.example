PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=globetrotter_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=globetrotter_super_secret_refresh_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=globetrotter
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/globetrotter

FRONTEND_URL=http://localhost:3000

# Email (Gmail SMTP, for password-reset OTPs)
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
